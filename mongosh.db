12:
db.books.deleteMany({year:{$lt:2000}})
{
  acknowledged: true,
  deletedCount: 1
}


13:
db.books.aggregate([{$match:{
        year:{$gt:2000}
    }},{$sort:{year:-1}},{$project:{"_id":0}}])


14:
db.books.aggregate([{$match:{
        year:{$gt:2000}
    }},{$project:{"_id":0,title:1,author:1,year:1}}])
{
  title: 'book3',
  author: 'ibrahim',
  year: 2006
}


15:
db.books.aggregate([{$unwind:"$genders"},{$project:{"_id":0,"title":1,"genders":1}}])
      
  title: 'book1',
  genders: 'fantasy'
}